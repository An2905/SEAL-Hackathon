# Copy → backend/.env.properties (local dev only)
# See root .env.example for full documentation of all variables.

# Database
DB_PASSWORD=your_database_password_here

# JWT Authentication
JWT_SECRET_KEY=your_very_secret_and_long_jwt_key_here

# Google reCAPTCHA
RECAPTCHA_SECRET=your_recaptcha_secret_key_here

# Brevo (email service)
BREVO_API_KEY=your_brevo_api_key_here

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:8080/api/auth/github/callback
GITHUB_FRONTEND_REDIRECT=http://localhost:5173/student
