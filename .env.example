# ============================================================
# SEAL Hackathon — Environment Variables
# ============================================================
# Copy this file and fill in the values:
#   Backend:  cp .env.example backend/.env.properties
#   Frontend: cp .env.example frontend/.env.properties
#
# Never commit actual secrets to the repository.
# ============================================================

# --- Backend (Spring Boot) ---

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hackathon
DB_USERNAME=root
DB_PASSWORD=your_database_password_here

# JWT Authentication
JWT_SECRET_KEY=your_very_secret_and_long_jwt_key_here

# Google reCAPTCHA
RECAPTCHA_SECRET=your_recaptcha_secret_key_here

# Brevo (email service)
BREVO_API_KEY=your_brevo_api_key_here

# --- Frontend (Vite) ---

# API base URL (proxied in dev, direct in production)
VITE_API_BASE=http://localhost:8080

# Google reCAPTCHA site key (public)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
